{
  "info": {
    "name": "Negare Finance",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "BASE_URL", "value": "http://localhost:4000" },
    { "key": "API_BASE", "value": "{{BASE_URL}}/api" },
    { "key": "ACCESS_TOKEN", "value": "" },
    { "key": "USER_TOKEN", "value": "" },
    { "key": "ADMIN_TOKEN", "value": "" },
    { "key": "productId", "value": "" },
    { "key": "ORDER_ID", "value": "" },
    { "key": "PAYMENT_ID", "value": "" },
    { "key": "cartItemId", "value": "" },
    { "key": "trackId", "value": "" },
    { "key": "poolId", "value": "" },
    { "key": "payoutId", "value": "" },
    { "key": "supplierId", "value": "" },
    { "key": "purchaseProductId", "value": "" },
    { "key": "fileId", "value": "" },
    { "key": "downloadToken", "value": "" },
    { "key": "freeProductId", "value": "" },
    { "key": "paidProductId", "value": "" },
    { "key": "adminUserId", "value": "" },
    { "key": "DONATION_ID", "value": "" }
  ],
  "item": [
    {
      "name": "Orders",
      "item": [
        {
          "name": "Create Order",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{API_BASE}}/orders",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [{\n    \"productId\": \"1024\",\n    \"quantity\": 1\n  }],\n  \"discount\": {\n    \"type\": \"FIXED\",\n    \"value\": 50000\n  }\n}"
            }
          }
        },
        {
          "name": "Get Order",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }
            ],
            "url": "{{API_BASE}}/orders/{{ORDER_ID}}"
          }
        },
        {
          "name": "Get Purchase Result",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }
            ],
            "url": "{{API_BASE}}/orders/{{ORDER_ID}}/purchase-result"
          }
        },
        {
          "name": "Pay Order via Gateway Init",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }
            ],
            "url": "{{API_BASE}}/orders/{{ORDER_ID}}/pay/gateway/init"
          }
        },
        {
          "name": "Pay Order via Wallet",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('order paid', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.status).to.eql('SUCCESS');",
                  "  pm.expect(body.id).to.be.a('string');",
                  "});",
                  "pm.environment.set('PAYMENT_ID', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }
            ],
            "url": "{{API_BASE}}/orders/{{ORDER_ID}}/pay-with-wallet"
          }
        },
        {
          "name": "Pay Order via Wallet - Insufficient Balance",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('insufficient balance', () => {",
                  "  pm.response.to.have.status(400);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.message).to.eql('موجودی کیف پول کافی نیست.');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }
            ],
            "url": "{{API_BASE}}/orders/{{ORDER_ID}}/pay-with-wallet"
          }
        }
      ]
    },
    {
      "name": "Admin Purchases",
      "item": [
        {
          "name": "Admin - List Purchases",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }
            ],
            "url": "{{API_BASE}}/admin/purchases?page=1&limit=20&status=SUCCESS&q=amir&from=2025-01-01T00:00:00.000Z&to=2025-12-31T23:59:59.999Z"
          }
        }
      ]
    },
    {
      "name": "Admin Credits",
      "item": [
        {
          "name": "Admin - List Credits",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }
            ],
            "url": "{{API_BASE}}/admin/credits?page=1&limit=20&type=PRODUCT_PURCHASE&q=ali&from=2025-01-01T00:00:00.000Z&to=2025-12-31T23:59:59.999Z"
          }
        }
      ]
    },
    {
      "name": "Admin Users",
      "item": [
        {
          "name": "Admin - User Downloads",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ADMIN_TOKEN}}" }
            ],
            "url": "{{API_BASE}}/admin/users/{{adminUserId}}/downloads?from=2025-01-01&to=2025-01-31&freeOnly=true&page=1&limit=20"
          }
        }
      ]
    },
    {
      "name": "Me Purchases",
      "item": [
        {
          "name": "Get Purchases",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "const first = body?.data?.items?.[0];",
                  "if (first) {",
                  "  pm.collectionVariables.set('purchaseProductId', first.productId);",
                  "  const dl = first.downloads?.[0];",
                  "  if (dl) {",
                  "    pm.collectionVariables.set('fileId', dl.fileId);",
                  "    const url = dl.url || '';",
                  "    const token = url.includes('token=') ? url.split('token=')[1] : '';",
                  "    if (token) pm.collectionVariables.set('downloadToken', token);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }
            ],
            "url": "{{API_BASE}}/me/purchases?page=1&pageSize=20"
          }
        },
        {
          "name": "Get Purchase By Product",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }
            ],
            "url": "{{API_BASE}}/me/purchases/{{purchaseProductId}}"
          }
        }
      ]
    },
    {
      "name": "Negative Cases",
      "item": [
        {
          "name": "Add Purchased Product To Cart",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" },
              { "key": "Content-Type", "value": "application/json" }
