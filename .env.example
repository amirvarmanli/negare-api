# --- Application ---
PORT=4000
NODE_ENV=development
GLOBAL_PREFIX=api
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000
API_PUBLIC_BASE_URL=http://localhost:4000/api
API_BASE_URL=http://localhost:4000
APP_PUBLIC_BASE_URL=http://localhost:3000

# --- Database (Docker default) ---
DATABASE_URL=postgresql://postgres:postgres@db:5432/negare_db
# For local host (non-Docker):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/negare_db

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=negare_db

# --- Auth / JWT ---
ACCESS_JWT_SECRET=replace-with-access-secret
ACCESS_JWT_EXPIRES=10m
REFRESH_JWT_SECRET=replace-with-refresh-secret
REFRESH_JWT_EXPIRES=30d
SET_PWD_JWT_SECRET=replace-with-set-password-secret
SET_PWD_JWT_EXPIRES=10m

# --- Cookies ---
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
COOKIE_REFRESH_PATH=/auth/refresh
COOKIE_ACCESS_PATH=/

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- SMS (Kavenegar) ---
KAVENEGAR_API_KEY=replace-with-kavenegar-key
KAVENEGAR_TEMPLATE=sendSMS
KAVENEGAR_TIMEOUT_MS=10000

# --- SMTP / Mail ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Negare <no-reply@example.com>"

# --- Zibal payment gateway ---
ZIBAL_MERCHANT=replace-with-merchant
ZIBAL_BASE_URL=https://gateway.zibal.ir
ZIBAL_CALLBACK_URL=http://localhost:4000/api/payments/zibal/callback

# --- Platform revenue split ---
PLATFORM_WALLET_USER_ID=00000000-0000-0000-0000-000000000000
PLATFORM_COMMISSION_PERCENT=30
SUPPLIER_REVENUE_PERCENT=70

# --- File uploads / FTP ---
FTP_HOST=ftp.example.com
FTP_PORT=21
FTP_USER=ftp-user
FTP_PASS=ftp-pass
FTP_SECURE=false
FTP_PUBLIC_BASE_URL=https://ftp.example.com
FILE_PUBLIC_BASE_URL=https://files.example.com
FTP_DOCROOT=domains/example.com/public_html
UPLOAD_PUBLIC_SUBDIR=
UPLOAD_BASE_DIR=uploads
UPLOAD_DIR=./uploads
UPLOAD_TMP_DIR=/tmp/negare-uploads
UPLOAD_CHUNK_SIZE=5242880
UPLOAD_TTL_SECONDS=86400
UPLOAD_MAX_SIZE_BYTES=1368709120
UPLOAD_CLEAN_INTERVAL_MIN=30
UPLOAD_MAX_TEMP_AGE_HOURS=6
UPLOAD_INTEGRITY_CHUNK=optional
UPLOAD_INTEGRITY_FILE=off

# --- Docker helpers ---
RUN_SEED=false
